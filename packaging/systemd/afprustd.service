[Unit]
Description=AFP file server for classic Mac OS (afprustd)
Documentation=man:afprustd(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
EnvironmentFile=-/etc/default/afprustd
ExecStartPre=/usr/sbin/afprustd -t $AFPRUSTD_OPTS
ExecStart=/usr/sbin/afprustd $AFPRUSTD_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
StateDirectory=afprust
StateDirectoryMode=0755
UMask=0022
LimitNOFILE=65536
LimitCORE=0

# afprustd starts as root only to authenticate users through PAM and to
# switch each session process to the user's uid/gids. Sessions then run
# with that user's credentials and no capabilities.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_NET_BIND_SERVICE CAP_KILL CAP_NET_ADMIN CAP_AUDIT_WRITE
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
# RestrictSUIDSGID= is deliberately not set: systemd implements it by
# making openat2() fail with ENOSYS, which would disable the kernel-enforced
# path confinement (RESOLVE_BENEATH) that afprustd relies on. AFP clients
# cannot set setuid/setgid bits anyway.
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# AF_APPLETALK is only used when "appletalk = yes"; AF_NETLINK for
# interface enumeration.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_APPLETALK AF_NETLINK

[Install]
WantedBy=multi-user.target
